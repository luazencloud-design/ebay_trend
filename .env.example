# ── Gemini API ──────────────────────────────────────────────
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.  (cp .env.example .env)
# .env 는 git에 올라가지 않습니다 (.gitignore).
#
# 키 발급:   https://aistudio.google.com/apikey
# 결제 활성화: https://aistudio.google.com/usage  (grounding 사용에 필수)
#            월 지출 한도(spend cap)는 ₩50,000 이상 권장 (실사용 주 ~₩2,000)

GEMINI_API_KEY=

# ── 선택 설정 (기본값으로 충분, 보통 안 건드림) ──────────────
# 배치 병렬 호출 동시성. 미설정 시 기본 4. Pro 유료 티어는 360 RPM 이라 6~8 안전.
# (단계별 모델은 환경변수가 아니라 scripts/daily-research.mjs 코드에서 결정됩니다.)
GEMINI_CONCURRENCY=6
